{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "./dist",

    "module": "commonjs",
    "target": "esnext",
    // "lib": ["esnext"],
    // "types": ["node"],

    "sourceMap": true,
    "declaration": false,
    "declarationMap": false,

    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "strict": true,
    "skipLibCheck": true,
    "strictNullChecks": true,

    "moduleDetection": "force",
    "typeRoots": ["node_modules/@types"]
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
