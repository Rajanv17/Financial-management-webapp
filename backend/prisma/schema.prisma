generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgres"
}

enum TransactionType {
  income
  expense
}

enum PaymentMethod {
  CASH          @map("Cash")
  CREDIT_CARD   @map("Credit Card")
  DEBIT_CARD    @map("Debit Card")
  BANK_TRANSFER @map("Bank Transfer")
  UPI           @map("UPI")
  OTHER         @map("Other")
}

enum BudgetPeriod {
  weekly
  monthly
  yearly
}

enum AccountType {
  bank
  cash
  wallet
  credit_card
  other
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(50)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  refreshToken String?  @map("refresh_token")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  accounts     FinancialAccount[]

  @@map("users")
}

model Category {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String?         @map("user_id") @db.Uuid
  name       String          @db.VarChar(50)
  type       TransactionType
  isDefault  Boolean         @default(false) @map("is_default")
  icon       String?         @db.VarChar(50)
  color      String?         @db.VarChar(9)
  isArchived Boolean         @default(false) @map("is_archived")
  archivedAt DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, type, name])
  @@index([userId])
  @@map("categories")
}

model Transaction {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  categoryId    String          @map("category_id") @db.Uuid
  title         String          @db.VarChar(100)
  amount        Decimal         @db.Decimal(12, 2)
  type          TransactionType
  date          DateTime        @default(now()) @db.Timestamptz(3)
  description   String?         @db.VarChar(150)
  paymentMethod PaymentMethod?  @default(CASH) @map("payment_method")
  accountId     String          @map("account_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account  FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([userId, date(sort: Desc)])
  @@index([userId, categoryId, date])
  @@index([userId, accountId, date])
  @@map("transactions")
}

model Budget {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  categoryId String       @map("category_id") @db.Uuid
  amount     Decimal      @db.Decimal(12, 2)
  period     BudgetPeriod @default(monthly)
  week       Int?         @db.SmallInt
  month      Int          @db.SmallInt
  year       Int          @db.SmallInt
  isActive   Boolean      @default(true) @map("is_active")
  isArchived Boolean      @default(false) @map("is_archived")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Partial unique index in migration 20261018123000_budgets_active_unique:
  // (user_id, category_id, month, year) WHERE is_archived = false.
  @@index([userId, year, month])
  @@map("budgets")
}

model FinancialAccount {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  name            String      @db.VarChar(50)
  type            AccountType
  openingBalance  Decimal     @default(0) @map("opening_balance") @db.Decimal(12, 2)
  currency        String      @default("INR") @db.VarChar(3)
  institutionName String?     @map("institution_name") @db.VarChar(100)
  color           String?     @db.VarChar(9)
  icon            String?     @db.VarChar(50)
  isDefault       Boolean     @default(false) @map("is_default")
  isArchived      Boolean     @default(false) @map("is_archived")
  archivedAt      DateTime?   @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
  @@map("financial_accounts")
}