NODE_ENV=
PORT=
DATABASE_URL=
# Separate Postgres database for `npm test`. Required for integration tests.
# Must not be missing and must not equal DATABASE_URL (setup throws if either is true).
TEST_DATABASE_URL=
CORS_ORIGIN=http://localhost:5173

ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d

REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d

# lax | strict | none. Used in production; development always uses lax.
COOKIE_SAMESITE=lax

# Render (and similar proxies): set to 1 so req.ip is the client address.
TRUST_PROXY=false

# Login, register, and refresh-token: max requests per window per IP.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# npm run seed:demo [-- username]. Looks up an existing user; never creates accounts.
# DEMO_USERNAME=demo
# Set to allow seeding a username other than "demo".
# DEMO_USERNAME_ALLOW=
